# Vercel AI Gateway. Required for /api/chat and for optional embedding rerank.
AI_GATEWAY_API_KEY=

# Deepgram. Server-only. Used to mint a short-lived /v1/auth/grant token and for the upload fallback.
DEEPGRAM_API_KEY=

# Optional comma-separated browser origins allowed to call the chat API besides this site's own host.
# CHAT_ALLOWED_ORIGINS=https://daptodentists.com.au,https://shellharbourdentist.com.au,https://woononadentists.com.au
CHAT_ALLOWED_ORIGINS=
